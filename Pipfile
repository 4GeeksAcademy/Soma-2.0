[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
autopep8 = "*"
pycodestyle = "*"

[packages]
flask = "*"
flask-sqlalchemy = "*"
flask-migrate = "*"
flask-swagger = "*"
psycopg = {extras = ["binary"], version = "*"}
python-dotenv = "*"
gunicorn = "*"
cloudinary = "*"
flask-admin = "==2.0.0"
typing-extensions = "*"
wtforms = "==3.1.2"
sqlalchemy = "*"
flask-jwt-extended = "*"
google-auth = "*"
google-auth-oauthlib = "*"
google-api-python-client = "*"
google-auth-httplib2 = "*"
flask-mail = "*"
flask-cors = "*"
# Dependencia transitiva de alembic para Python <3.11 (usa tomllib de la
# stdlib en 3.11+, y cae a este paquete si no esta) -- explicita aca porque
# Pipfile.lock se genera en local (Python 3.13, no lo necesita) pero Render
# corre Python 3.10.6 (PYTHON_VERSION en render.yaml), donde si hace falta.
tomli = "*"

[requires]
# python_version = "3.14"

[scripts]
start="flask run -p 3001 -h 0.0.0.0"
init="flask db init"
migrate="flask db migrate"
local="heroku local"
upgrade="flask db upgrade"
downgrade="flask db downgrade"
insert-test-data="flask insert-test-data"
reset_db="bash ./docs/assets/reset_migrations.bash"
deploy="echo 'Please follow this 3 steps to deploy: https://github.com/4GeeksAcademy/flask-rest-hello/blob/master/README.md#deploy-your-website-to-heroku' "
